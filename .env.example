# Variables à définir dans Dokploy (onglet Environment de l'app birostweb).
# Noms uniquement : NE JAMAIS committer de vraies valeurs. En prod, Dokploy les injecte à l'exécution
# (jamais en ARG/ENV de build).

# --- SMTP (unique ; aucun secours automatique) ---
SMTP_HOST=
SMTP_USERNAME=
# Mot de passe d'application du fournisseur (aucune valeur ici)
SMTP_PASSWORD=
SMTP_PORT=
SMTP_SECURE=

# Destinataire des demandes reçues (défaut : contact@theo-birost.fr).
# CONTACT_TO=

# Secret aléatoire (>= 32 caractères, obligatoire) : signe le jeton du formulaire (HMAC) et le captcha Altcha.
# Sans lui, altcha.php et send_mail.php répondent 503. Générer avec : openssl rand -hex 32
CONTACT_FORM_SECRET=

# --- Garde-fous du formulaire (optionnels) ---
# Kill-switch : "1" coupe l'envoi immédiatement (sans redéploiement).
CONTACT_FORM_DISABLED=
# Plafond global d'e-mails sur 24 h glissantes (défaut 30).
CONTACT_FORM_DAILY_CAP=
# Proxys de confiance (CIDR séparés par des virgules) autorisés à fournir X-Forwarded-For.
# Défaut : réseaux privés/loopback (Traefik sur le réseau Docker). Hors proxy de confiance, REMOTE_ADDR est utilisé.
# TRUSTED_PROXIES=
# Dossier d'état (quotas, anti-rejeu). Défaut : dossier temporaire du conteneur (éphémère). Volume pour persister.
# CONTACT_STATE_DIR=
# Dossier des logs du formulaire (défaut : dossier temporaire du conteneur, éphémère) et rétention en jours (défaut 30).
# CONTACT_LOG_DIR=
# CONTACT_LOG_RETENTION_DAYS=

# Port d'écoute (entier 1024-65535, défaut 8080).
# PORT=
