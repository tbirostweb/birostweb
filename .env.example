# Variables à définir dans Dokploy (onglet Environment de l'app birostweb).
# NE PAS committer de vraies valeurs. En prod, Dokploy les injecte dans l'environnement.

# ============================================================
#  SMTP PRIMAIRE (le formulaire l'essaie en premier)
#  Actuellement Gmail, car l'envoi SMTP de la boîte OVH est bloqué
#  par OVH depuis la suspension pour spam. Quand OVH rétablit l'envoi,
#  tu peux repasser OVH en primaire (voir le bloc SECOURS ci-dessous).
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=tbirostweb@gmail.com
# App password Gmail (16 caractères, SANS espaces). À créer sur :
# https://myaccount.google.com/apppasswords  (compte Google → Sécurité → Mots de passe des applications)
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_PORT=587
SMTP_SECURE=tls

# ============================================================
#  SMTP SECOURS (utilisé automatiquement si le primaire échoue)
#  Boîte OVH : la garder ici pour rebasculer dessus dès qu'OVH
#  aura rétabli l'authentification SMTP.
# ============================================================
SMTP2_HOST=pro2.mail.ovh.net
SMTP2_USERNAME=contact@theo-birost.fr
SMTP2_PASSWORD=xxxxxxxxxxxx
SMTP2_PORT=587
SMTP2_SECURE=tls

# Destinataire des demandes reçues (défaut : contact@theo-birost.fr).
# Mets tbirostweb@gmail.com si tu préfères tout centraliser sur Gmail.
# CONTACT_TO=contact@theo-birost.fr

# Secret aléatoire pour signer le jeton anti-spam du formulaire (HMAC) + le captcha Altcha.
# Génère-en un avec :  openssl rand -hex 32
CONTACT_FORM_SECRET=change-moi-par-une-longue-chaine-aleatoire

# --- Garde-fous du formulaire (optionnels) ---
# Kill-switch : mets "1" pour couper l'envoi du formulaire immédiatement (sans redéploiement).
CONTACT_FORM_DISABLED=0
# Plafond global d'e-mails sur 24 h glissantes (toutes IP confondues). Défaut : 30.
CONTACT_FORM_DAILY_CAP=30
# Dossier des logs du formulaire (défaut : /tmp, éphémère). Monte un volume pour les garder.
# CONTACT_LOG_DIR=/var/log/contact
