# ============================================================
#  birostweb.fr — durcissement Apache (site PHP)
#  HTTPS/TLS est géré en amont par Traefik (Dokploy).
# ============================================================

# Pas de listing de répertoire
Options -Indexes

# Ne pas divulguer la version PHP
<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>

# ---------------- En-têtes de sécurité ----------------
<IfModule mod_headers.c>
    # Forcer HTTPS 2 ans (ajouter "preload" seulement après soumission à hstspreload.org)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # autoplay/fullscreen/encrypted-media ouverts au lecteur Bunny Stream (galerie vidéo),
    # pour que la lecture démarre au clic sur la façade (iframe mediadelivery.net).
    Header always set Permissions-Policy "accelerometer=(), autoplay=(self \"https://iframe.mediadelivery.net\"), camera=(), display-capture=(), encrypted-media=(self \"https://iframe.mediadelivery.net\"), fullscreen=(self \"https://iframe.mediadelivery.net\"), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    # CSP : script-src verrouillé par le hash du <script> inline (pas de 'unsafe-inline' JS)
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; script-src 'self' 'sha256-MElwAQPFOXkhfYKNekzyN/4Wvo5YlDnCSGTnYthKKPc=' 'sha256-R4eRa3/WLHKJOqFKPw80xNKQkRAO79l8teDuT1Zpv2M='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.b-cdn.net; font-src 'self'; connect-src 'self'; form-action 'self'; frame-src https://iframe.mediadelivery.net https://*.mediadelivery.net; frame-ancestors 'none'; object-src 'none'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
    # Ne pas exposer la techno serveur
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# ---------------- Cache ----------------
<IfModule mod_headers.c>
    # Fichiers statiques : les URL versionnées par asset() (index.php, ?v=<empreinte>)
    # changent à chaque modification -> cache 1 an sans revalidation.
    # Sans ?v= (icônes du manifest, liens directs…) : revalidation à chaque visite
    # (réponse 304 légère si rien n'a changé), donc jamais de version périmée.
    <FilesMatch "\.(css|js|webp|png|jpe?g|gif|svg|ico|pdf|webmanifest)$">
        <If "%{QUERY_STRING} =~ /(^|&)v=/">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
        <Else>
            Header set Cache-Control "no-cache"
        </Else>
    </FilesMatch>
    # Polices : appelées par fonts.css sans version, mais elles ne changent jamais.
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Le HTML PHP ne doit jamais être mis en cache
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    # Pages HTML statiques (CGV, mentions, 404) : toujours revalidées
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ---------------- Fichiers sensibles : accès interdit ----------------
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "(composer\.(json|lock)|package(-lock)?\.json|\.gitignore|\.htaccess|entrypoint\.sh)$">
    Require all denied
</FilesMatch>

# ---------------- Réécritures ----------------
RewriteEngine On

# Rediriger www -> non-www (301), en conservant HTTPS et le chemin.
# HTTPS est forcé en amont par Traefik ; on reconstruit donc l'URL en https.
RewriteCond %{HTTP_HOST} ^www\.birostweb\.fr$ [NC]
RewriteRule ^(.*)$ https://birostweb.fr/$1 [R=301,L]

# Forcer le slash final sur /admin en HTTPS. Sans ça, Apache (derrière Traefik,
# sur le port interne 8080) génère une redirection cassée vers http://…:8080/admin/.
RewriteRule ^admin$ https://%{HTTP_HOST}/admin/ [R=301,L]

# Bloquer tout le dossier vendor en accès direct
RewriteRule ^vendor/ - [F,L]

# Autoriser explicitement /.well-known/
RewriteRule ^\.well-known/ - [L]

# Route propre pour la galerie : /galerie (slash final optionnel) -> galerie.php
RewriteRule ^galerie/?$ galerie.php [L]

# ---------------- Compression ----------------
# Brotli si le module est présent (meilleure compression que gzip sur le texte).
# Encadré par IfModule : aucun impact si mod_brotli est absent.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml application/manifest+json
</IfModule>

# 404 personnalisée
ErrorDocument 404 /404.html
