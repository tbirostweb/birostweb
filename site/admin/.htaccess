# ============================================================
#  Back-office /admin — durcissement
#  HTTPS/TLS géré en amont par Traefik (Dokploy).
# ============================================================

Options -Indexes

<IfModule mod_headers.c>
    # Jamais indexé par les moteurs de recherche.
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    # Ne jamais mettre en cache les pages d'administration.
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
</IfModule>

# Ne jamais servir les fichiers internes (_bootstrap.php, etc.).
<FilesMatch "^_">
    Require all denied
</FilesMatch>

# ============================================================
#  Limites d'upload : strictes pour tout /admin (dont la connexion, accessible
#  sans authentification), relâchées UNIQUEMENT pour gallery_edit.php (photos et
#  vidéos de la galerie, derrière l'authentification).
#  mod_php est actif : php_value est pris en compte ici. file_uploads est
#  PHP_INI_SYSTEM (non modifiable en .htaccess) ; on joue sur les directives
#  PERDIR (upload_max_filesize, post_max_size) + LimitRequestBody.
# ============================================================
LimitRequestBody 1048576
<IfModule mod_php.c>
    php_value upload_max_filesize 1M
    php_value post_max_size 1M
</IfModule>

<Files "gallery_edit.php">
    # Vidéos de la galerie : upload médié par le serveur vers Bunny Stream.
    LimitRequestBody 220000000
    <IfModule mod_php.c>
        php_value upload_max_filesize 200M
        php_value post_max_size 210M
        # Transfert serveur -> Bunny : laisse le temps pour un clip de ~200 Mo.
        php_value max_execution_time 300
        # Décodage GD des images (jusqu'à 30 Mpx) : marge mémoire.
        php_value memory_limit 256M
    </IfModule>
</Files>
